# Kopieren nach deploy/.env und ausfüllen:  cp .env.example .env && nano .env
# Starke Zufallswerte erzeugen:  openssl rand -hex 32

# Domain(s), unter denen die Seite läuft (Caddy holt dafür automatisch HTTPS-Zertifikate)
SITE_DOMAINS=neu.wohnfee.at
# Basis für Links in E-Mails (Angebote, Passwort-Reset …) – ohne Schrägstrich am Ende
NUXT_SITE_URL=https://neu.wohnfee.at

# Sitzungs-Schlüssel fürs Dashboard (NICHT der lokale Dev-Wert!)
NUXT_ADMIN_SECRET=

# Datenbank (läuft im Container „db", nicht von außen erreichbar)
NUXT_DB_NAME=wohnfee
NUXT_DB_USER=wohnfee
NUXT_DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# E-Mail-Versand (Zugangsdaten des Postfachs beim Mail-Anbieter, z. B. Domainfactory)
NUXT_SMTP_HOST=
NUXT_SMTP_PORT=465
NUXT_SMTP_USER=
NUXT_SMTP_PASSWORD=
NUXT_MAIL_FROM=WOHNFEE <office@wohnfee.at>
