# Domains aus .env (SITE_DOMAINS), z. B. "neu.wohnfee.at" oder "www.wohnfee.at, wohnfee.at"
{$SITE_DOMAINS} {
	encode zstd gzip
	# Uploads bis 15 MB (Fotos aus dem Dashboard)
	request_body {
		max_size 15MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	reverse_proxy app:3000
}
